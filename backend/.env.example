# Backend production environment variables

# App
NODE_ENV=production
PORT=3000

# Database
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DIALECT=mysql

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=2h

# CORS
FRONTEND_URL=
FRONTEND_URLS=

# Email (production SMTP)
EMAIL_USER=
EMAIL_PASSWORD=

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=uploads

# Socket server (external/railway)
SOCKET_MODE=external
SOCKET_PORT=4000

# Backups (not recommended on Vercel serverless)
BACKUP_MODE=external
ENABLE_AUTO_BACKUP=false
BACKUP_CRON_SCHEDULE=0 2 * * *

# Database sync (set true only when you want to sync models)
DB_SYNC=false
